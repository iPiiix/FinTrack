# Backend Configuration
# Database URL (PostgreSQL recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/fintrack

# JWT Secret Key (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=your-super-secret-key-change-me

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Email Configuration (for notifications)
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Admin Panel
ADMIN_PANEL_USER=admin
ADMIN_PANEL_PASSWORD=secure-admin-password
ADMIN_PANEL_SECRET=admin-secret-key

# AI Integration (Gemini)
GEMINI_API_KEY=your-gemini-api-key

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# Cloudflare Turnstile (Bot Protection)
TURNSTILE_SECRET_KEY=your-turnstile-secret
TURNSTILE_SITE_KEY=your-turnstile-site-key
